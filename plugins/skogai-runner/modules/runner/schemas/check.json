{
  "type": "object",
  "description": "findings in okn's issue shape",
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "rule": { "type": "string", "description": "kebab-case rule id" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string" }
        },
        "required": ["path", "line", "rule", "severity", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["issues"],
  "additionalProperties": false
}
