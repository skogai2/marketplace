#!/usr/bin/env bash
# Installed via: git config core.hooksPath scripts/git-hooks
# When a manifest is staged, marketplace.json must match what
# scripts/generate-marketplace-json.sh would write.
set -euo pipefail

if git diff --cached --name-only | grep -qE '^(\.claude-plugin/|plugins/[^/]+/\.claude-plugin/)'; then
  "$(git rev-parse --show-toplevel)/scripts/generate-marketplace-json.sh" --check >/dev/null
fi
