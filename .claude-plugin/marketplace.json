{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "skogai-marketplace",
  "owner": {
    "name": "skogix"
  },
  "metadata": {
    "pluginRoot": "./plugins/",
    "description": "skogai marketplace"
  },
  "plugins": [
    {
      "name": "skogai-core",
