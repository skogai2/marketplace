#!/usr/bin/env bash
# @describe skogai: config, modules, and every module's commands
#
# generated by `skogai module build` from core's templates/main.sh; rebuild,
# don't edit. every command runs through $BIN, so a module found after the
# build runs too, only without help and completion here.
# @meta binname skogai

# shellcheck disable=SC2154 # argc_* are assigned by --argc-eval
set -euo pipefail

# >>> generated
BIN=/home/skogix/.local/src/marketplace/plugins/skogai-runner/bin/skogai
CORE=/home/skogix/.local/src/marketplace/plugins/skogai-runner/modules/core/argc.sh
declare -A CMDS=()

# @cmd read and write key/value config across system, global, local and module layers
# @arg args~[?`_choice_forward`]
config() { exec "$BIN" config "${argc_args[@]}"; }


# @cmd find, show, install and scaffold modules
# @arg args~[?`_choice_forward`]
module() { exec "$BIN" module "${argc_args[@]}"; }

CMDS[memory]=/home/skogix/.local/src/marketplace/plugins/skogai-runner/modules/memory/argc.sh

# @cmd one fact per file, each with a stale_after; expired ones get decided on
# @arg args~[?`_choice_forward`]
memory() { exec "$BIN" memory "${argc_args[@]}"; }

CMDS[runner]=/home/skogix/.local/src/marketplace/plugins/skogai-runner/modules/runner/argc.sh

# @cmd typed io for handing work to agents, prompt + files -> json matching a schema
# @arg args~[?`_choice_forward`]
runner() { exec "$BIN" runner "${argc_args[@]}"; }

KNOWN=config\|module\|help\|memory\|runner
# <<< generated

# completion for a forwarded command: ask its own script, with the env it runs with
_choice_forward() {
    local name="$argc__cmd_fn" file words=()
    file="${CMDS[$name]:-}"
    if [[ -n $file ]]; then
        eval "$("$BIN" module env "$name")"
        words=("skogai $name")
    else
        file="$CORE" words=(skogai "$name")
    fi
    argc --argc-compgen generic "$file" "${words[@]}" "${argc__args[@]:argc__cmd_arg_index+1}" |
        awk -F '\t' '$1 ~ /^__argc_value=/ { print tolower($1); next } $1 ~ /^__argc_/ { print $1; next } $2 ~ /^\/color:/ { print $1 (NF >= 3 ? "\t" $3 : ""); next } { print }'
}

if [[ ${ARGC_COMPGEN:-0} != 1 && -n ${1:-} && ${1:-} != -* && "|$KNOWN|" != *"|$1|"* ]]; then
    exec "$BIN" "$@"
fi

eval "$(argc --argc-eval "$0" "$@")"
